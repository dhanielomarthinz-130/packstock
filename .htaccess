<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /packstock/

# Disable directory browsing
Options -Indexes

# 1. External Redirect: Remove index.php / index to trailing slash for GET requests
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/packstock/(?:index\.php|index)[\s\?] [NC]
RewriteRule ^ ./ [R=301,L]

RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/packstock/(.*)/index(?:\.php)?[\s\?] [NC]
RewriteRule ^ %1/ [R=301,L]

# 2. External Redirect: Remove .php from non-API GET requests (e.g. /packstock/login.php -> /packstock/login)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} !/packstock/api/ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/packstock/([^\s\?]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Allow real directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. If extensionless file exists with .php, rewrite internally
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]

# 5. Allow existing static assets (css, js, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
</IfModule>
