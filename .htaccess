<IfModule mod_rewrite.c>
RewriteEngine On

# Disable directory browsing
Options -Indexes

# 1. External Redirect: Remove index.php or index from URL to trailing slash
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/([^\s\?]*/)?(?:index\.php|index)[\s\?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. External Redirect: Remove .php extension from non-API GET requests (e.g. /login.php -> /login)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteCond %{THE_REQUEST} \s/([^\s\?]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Allow real directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. If extensionless file exists with .php, rewrite internally
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]

# 5. Allow existing static assets (css, js, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
</IfModule>

<IfModule mod_headers.c>
    # Disable caching for dynamic PHP files
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
